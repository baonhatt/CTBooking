generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model accounts {
  id         Int       @id @default(autoincrement())
  user_id    Int
  email      String    @unique
  password   String?
  login_type String    @default("email")
  is_active  Boolean?  @default(true)
  created_at DateTime? @default(now())
  updated_at DateTime? @default(now())
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tokens     tokens[]
}

model users {
  id         Int        @id @default(autoincrement())
  fullname   String?
  phone      String?
  avatar     String?
  gender     String?
  dob        DateTime?
  created_at DateTime?  @default(now())
  updated_at DateTime?  @default(now())
  accounts   accounts[]
  bookings   bookings[]
}

model tokens {
  id         Int       @id @default(autoincrement())
  account_id Int
  type       String
  token      String    @unique
  expired_at DateTime?
  created_at DateTime  @default(now())
  account    accounts  @relation(fields: [account_id], references: [id], onDelete: Cascade)
}

model movies {
  id            Int        @id @default(autoincrement())
  title         String
  description   String?
  cover_image   String?
  detail_images Json?
  genres        Json?
  rating        Decimal?
  duration_min  Int?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @default(now())
  is_active     Boolean?   @default(true)
  release_date  DateTime?
  bookings      bookings[]
}

model bookings {
  id                Int              @id @default(autoincrement())
  user_id           Int
  ticket_count      Int              @default(1)
  total_price       Decimal
  created_at        DateTime         @default(now())
  paid_at           DateTime?
  payment_method    String?          @default("cash")
  payment_status    String?          @default("pending")
  transaction_id    String?
  updated_at        DateTime         @default(now())
  name              String           @default("")
  phone             String           @default("")
  email             String           @default("")
  booking_code      String?          @unique
  is_used           Boolean?         @default(false)
  movie_id          Int?
  ticket_package_id Int?
  expiry_date       DateTime?
  movies            movies?          @relation(fields: [movie_id], references: [id], onDelete: Cascade)
  ticket_packages   ticket_packages? @relation(fields: [ticket_package_id], references: [id])
  user              users            @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model toys {
  id         Int      @id @default(autoincrement())
  name       String
  category   String?
  price      Decimal
  stock      Int      @default(0)
  status     String   @default("active")
  image_url  String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model ticket_packages {
  id             Int        @id @default(autoincrement())
  name           String
  code           String?    @unique
  description    String?
  price          Decimal
  features       Json?
  type           String?
  min_group_size Int?
  max_group_size Int?
  is_member_only Boolean?   @default(false)
  is_active      Boolean?   @default(true)
  display_order  Int?       @default(0)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @default(now())
  bookings       bookings[]
}

model site_media {
  id            Int       @id @default(autoincrement())
  section       String
  type          String
  title         String?
  description   String?
  public_id     String?
  url           String
  format        String?
  width         Int?
  height        Int?
  duration      Float?
  display_order Int?      @default(0)
  is_active     Boolean?  @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now())
}

