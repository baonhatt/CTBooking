# Admin app (Vite). Copy to .env and fill in. Only VITE_* values reach the browser, so never put a secret here.
# Server-side secrets (Cloudinary secret, SePay, Brevo ...) go in worker/.dev.vars locally and in
# `wrangler secret put` on Cloudflare. See worker/.dev.vars.example.

# Cloudinary (public values only; the upload preset is unsigned)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET_IMAGE=
VITE_CLOUDINARY_UPLOAD_PRESET_VIDEO=

# Set to true to show the maintenance page
VITE_IS_MAINTENANCE=false
