{
  "name": "cinema-next-client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cf": "node scripts/inject-edge-runtime.mjs && npx @cloudflare/next-on-pages",
    "preview": "npx wrangler pages dev",
    "pages:deploy:preview": "npm run build:cf && npx wrangler pages deploy --env preview",
    "pages:deploy:prod": "npm run build:cf && npx wrangler pages deploy --env production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.84.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "lucide-react": "^0.539.0",
    "next": "14.2.29",
    "nextjs-toploader": "^3.9.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.0",
    "@cloudflare/workers-types": "^4.20251224.0",
    "@types/node": "^24.10.1",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2",
    "wrangler": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.23",
      "@types/react-dom": "18.3.7"
    }
  }
}
