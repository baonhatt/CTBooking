{
  "name": "fusion-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --env preview --port 8787 --config worker/wrangler.toml",
    "dev:worker:local": "wrangler dev --local --config worker/wrangler.toml",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:worker\"",
    "dev:debug": "tsx --inspect=9229 --tsconfig tsconfig.json node_modules/vite/bin/vite.js",
    "build": "npm run build:client",
    "build:next": "cd next-client && npm run build:cf",
    "build:client": "cross-env VITE_SERVER_BASE_URL=https://api.cinesphere.com.vn vite build",
    "build:client:preview": "cross-env VITE_SERVER_BASE_URL=https://cinema-worker-preview.baonhat20.workers.dev vite build --mode preview",
    "format.fix": "prettier --write .",
    "typecheck": "tsc",
    "deploy:preview": "npx wrangler deploy --env preview --config worker/wrangler.toml",
    "deploy:prod": "npx wrangler deploy --config worker/wrangler.toml",
    "pages:deploy:prod": "npm run build:client && npx wrangler pages deploy dist/spa --project-name=cinema-admin-pages --branch=main",
    "pages:deploy:preview": "npm run build:client:preview && npx wrangler pages deploy dist/spa --project-name=cinema-admin-pages --branch=preview",
    "db:init-local": "npm run db:reset-local && npm run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply cinema-db --local --config worker/wrangler.toml",
    "db:migrate:preview": "wrangler d1 migrations apply cinema_db --remote --env preview --config worker/wrangler.toml",
    "db:migrate:prod": "wrangler d1 migrations apply cinema_db --remote --config worker/wrangler.toml",
    "db:export-prod": "npx wrangler d1 export cinema-db --remote --output=cinema_db_prod.sql --config worker/wrangler.toml",
    "db:reset-local": "node scripts/db-reset-local.cjs",
    "db:import-local": "node scripts/db-prepare-dump.cjs && npx wrangler d1 execute cinema-db --local --file=cinema_db_prod.local.sql --config worker/wrangler.toml",
    "db:clone-prod-local": "npm run db:export-prod && npm run db:reset-local && npm run db:import-local"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^11.1.0",
    "bcryptjs": "^3.0.3",
    "ckeditor5": "^48.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.1",
    "react-helmet-async": "^3.0.0",
    "wrangler": "^4.124.0",
    "xss": "^1.0.15",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251224.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.84.2",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.539.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "overrides": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7"
  }
}
